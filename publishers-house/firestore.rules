rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'joshuaagunbiade@gmail.com' ||
        request.auth.token.email == 'thepublishershouse007@gmail.com' ||
        (hasProfile() && (
          userData().role == 'admin' ||
          userData().role == 'super_admin' ||
          userData().role == 'portal_manager'
        ))
      );
    }

    function isUnitHead() {
      return hasProfile() && userData().role == 'unit_head';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function privilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'activityTier', 'assignedUnitId']);
    }

    function isGuestCheckIn() {
      return request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'timestamp', 'date', 'type',
          'mode', 'location', 'streamChannel', 'serviceCode',
          'isGuest', 'userId', 'checkedInBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 120
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() < 40;
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isSelf(userId)
        || (isUnitHead() && resource.data.assignedUnitId == userData().assignedUnitId);

      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'member'
        && request.resource.data.activityTier == 'regular'
        && (
          !request.resource.data.keys().hasAny(['assignedUnitId'])
          || request.resource.data.assignedUnitId == ''
        );

      allow update: if isAdmin()
        || (isSelf(userId) && privilegedFieldsUnchanged());

      allow delete: if isAdmin();
    }

    match /sermons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leadership/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gatherings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transactions/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /prayers/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /testimonies/{docId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.content is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() < 5000;
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow create: if isSignedIn() || isGuestCheckIn();
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.phone == userData().phone)
        || (isSignedIn() && resource.data.loggedBy == request.auth.uid)
        || (isUnitHead() && resource.data.unitId == userData().assignedUnitId);
      allow update, delete: if isAdmin();
    }

    match /attendance_headcounts/{docId} {
      allow read, write: if isAdmin() || isUnitHead();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pastoral_notes/{docId} {
      allow read, write: if isAdmin();
    }

    // Portal & church configuration — admin-only read/write
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Pastoral care pipeline entries
    match /pastoral_care/{docId} {
      allow read, write: if isAdmin();
    }

    // Growth track / courses — members can read, admins write
    match /courses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Unit-level operational collections — unit heads & admins can manage
    match /unit_assets/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isUnitHead();
      allow update, delete: if isAdmin() || isUnitHead();
    }

    match /unit_attendance/{docId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isUnitHead();
      allow update, delete: if isAdmin() || isUnitHead();
    }

    match /unit_rosters/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isUnitHead();
      allow update: if isAdmin();
    }

    match /unit_swaps/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || isUnitHead();
      allow delete: if isAdmin();
    }

    // Allow user subcollections (e.g. playback history)
    match /users/{userId}/{subcollection=**} {
      allow read, write: if isAdmin() || isSelf(userId);
    }

    // Catch-all: deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
